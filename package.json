{
  "name": "anyai",
  "version": "0.1.0",
  "description": "One API. Any AI provider.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:smoke": "vitest run -t smoke"
  },
  "peerDependencies": {
    "@google/generative-ai": "^0.11.0",
    "openai": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@google/generative-ai": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "@types/node": "^25.2.2",
    "openai": "^4.104.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=18"
  }
}
