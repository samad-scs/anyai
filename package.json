{
  "name": "anyai",
  "version": "0.1.0",
  "description": "One API. Any AI provider.",
  "homepage": "https://github.com/samad-ai/anyai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samad-ai/anyai.git"
  },
  "keywords": [
    "ai",
    "llm",
    "openai",
    "gemini",
    "anthropic",
    "ai-runtime",
    "provider-agnostic",
    "sdk"
  ],
  "author": "Samad Saiyed",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:types": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest",
    "test:smoke": "vitest run -t smoke"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "@google/generative-ai": "^0.24.1",
    "openai": "^4.104.0"
  },
  "engines": {
    "node": ">=18"
  }
}
